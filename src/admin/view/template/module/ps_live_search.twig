{{ header }}
{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<button type="submit" form="form-analytics" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
				<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div class="card">
			<div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
			<div class="card-body">
				<form id="form-analytics" action="{{ action }}" method="post" data-oc-toggle="ajax">

					<ul class="nav nav-tabs">
						<li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ tab_general }}</a></li>
						<li class="nav-item"><a href="#tab-products" data-bs-toggle="tab" class="nav-link">{{ tab_products }}</a></li>
						<li class="nav-item"><a href="#tab-categories" data-bs-toggle="tab" class="nav-link">{{ tab_categories }}</a></li>
						<li class="nav-item"><a href="#tab-manufacturers" data-bs-toggle="tab" class="nav-link">{{ tab_manufacturers }}</a></li>
						<li class="nav-item"><a href="#tab-informations" data-bs-toggle="tab" class="nav-link">{{ tab_informations }}</a></li>
						<li class="nav-item"><a href="#tab-support" data-bs-toggle="tab" class="nav-link">{{ tab_help_and_support }}</a></li>
					</ul>

					<div class="tab-content">
						<div id="tab-general" class="tab-pane active">

							<div class="row mb-3">
								<label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_status" value="0">
										<input type="checkbox" name="module_ps_live_search_status" value="1" id="input-status" class="form-check-input" {% if module_ps_live_search_status %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-input-delay" class="col-sm-2 col-form-label">{{ entry_input_delay }}</label>
								<div class="col-sm-10">
									<input type="text" name="module_ps_live_search_input_delay" value="{{ module_ps_live_search_input_delay | default('100') }}" placeholder="{{ entry_input_delay }}" id="input-input-delay" class="form-control">
									<div id="error-input-input-delay" class="invalid-feedback"></div>
									<div class="form-text">{{ help_input_delay }}</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-input-min-chars" class="col-sm-2 col-form-label">{{ entry_input_min_chars }}</label>
								<div class="col-sm-10">
									<input type="text" name="module_ps_live_search_input_min_chars" value="{{ module_ps_live_search_input_min_chars | default('1') }}" placeholder="{{ entry_input_min_chars }}" id="input-input-min-chars" class="form-control">
									<div id="error-input-input-min-chars" class="invalid-feedback"></div>
									<div class="form-text">{{ help_input_min_chars }}</div>
								</div>
							</div>

						</div>
						<div id="tab-products" class="tab-pane">

							<div class="row mb-3">
								<label for="input-product-status" class="col-sm-2 col-form-label">{{ entry_product_status }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_product_status" value="0">
										<input type="checkbox" name="module_ps_live_search_product_status" value="1" id="input-product-status" class="form-check-input" {% if module_ps_live_search_product_status %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3">
								<label for="input-product-description" class="col-sm-2 col-form-label">{{ entry_product_description }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_product_description" value="0">
										<input type="checkbox" name="module_ps_live_search_product_description" value="1" id="input-product-description" class="form-check-input" {% if module_ps_live_search_product_description %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-product-description-length" class="col-sm-2 col-form-label">{{ entry_product_description_length }}</label>
								<div class="col-sm-10">
									<input type="text" name="module_ps_live_search_product_description_length" value="{{ module_ps_live_search_product_description_length | default('200') }}" placeholder="{{ entry_product_description_length }}" id="input-product-description-length" class="form-control">
									<div id="error-input-product-description-length" class="invalid-feedback"></div>
									<div class="form-text">{{ help_product_description_length }}</div>
								</div>
							</div>

							<div class="row mb-3">
								<label for="input-product-image" class="col-sm-2 col-form-label">{{ entry_product_image }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_product_image" value="0">
										<input type="checkbox" name="module_ps_live_search_product_image" value="1" id="input-product-image"  class="form-check-input" {% if module_ps_live_search_product_image %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-product-image-width" class="col-sm-2 col-form-label">{{ entry_product_image_size }}</label>
								<div class="col-sm-10">
									<div id="input-image-thumb" class="row">
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_product_image_width" value="{{ module_ps_live_search_product_image_width }}" placeholder="{{ entry_width }}" id="input-product-image-width" class="form-control">
											<div id="error-input-product-image-width" class="invalid-feedback"></div>
										</div>
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_product_image_height" value="{{ module_ps_live_search_product_image_height }}" placeholder="{{ entry_height }}" id="input-product-image-height" class="form-control">
											<div id="error-input-product-image-height" class="invalid-feedback"></div>
										</div>
									</div>
								</div>
							</div>

							<div class="row mb-3">
								<label for="input-product-price" class="col-sm-2 col-form-label">{{ entry_product_price }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_product_price" value="0">
										<input type="checkbox" name="module_ps_live_search_product_price" value="1" class="form-check-input" {% if module_ps_live_search_product_price %} checked{% endif %} id="input-product-price">
									</div>
								</div>
							</div>

						</div>
						<div id="tab-categories" class="tab-pane">

							<div class="row mb-3">
								<label for="input-category-status" class="col-sm-2 col-form-label">{{ entry_category_status }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_category_status" value="0">
										<input type="checkbox" name="module_ps_live_search_category_status" value="1" id="input-category-status" class="form-check-input" {% if module_ps_live_search_category_status %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3">
								<label for="input-category-image" class="col-sm-2 col-form-label">{{ entry_category_image }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_category_image" value="0">
										<input type="checkbox" name="module_ps_live_search_category_image" value="1" id="input-category-image" class="form-check-input" {% if module_ps_live_search_category_image %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-category-image-width" class="col-sm-2 col-form-label">{{ entry_category_image_size }}</label>
								<div class="col-sm-10">
									<div id="input-image-thumb" class="row">
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_category_image_width" value="{{ module_ps_live_search_category_image_width }}" placeholder="{{ entry_width }}" id="input-category-image-width" class="form-control">
											<div id="error-input-category-image-width" class="invalid-feedback"></div>
										</div>
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_category_image_height" value="{{ module_ps_live_search_category_image_height }}" placeholder="{{ entry_height }}" id="input-category-image-height" class="form-control">
											<div id="error-input-category-image-height" class="invalid-feedback"></div>
										</div>
									</div>
								</div>
							</div>

						</div>
						<div id="tab-manufacturers" class="tab-pane">

							<div class="row mb-3">
								<label for="input-manufacturer-status" class="col-sm-2 col-form-label">{{ entry_manufacturer_status }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_manufacturer_status" value="0">
										<input type="checkbox" name="module_ps_live_search_manufacturer_status" value="1" id="input-manufacturer-status" class="form-check-input" {% if module_ps_live_search_manufacturer_status %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3">
								<label for="input-manufacturer-image" class="col-sm-2 col-form-label">{{ entry_manufacturer_image }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_manufacturer_image" value="0">
										<input type="checkbox" name="module_ps_live_search_manufacturer_image" value="1" id="input-manufacturer-image" class="form-check-input" {% if module_ps_live_search_manufacturer_image %} checked{% endif %}>
									</div>
								</div>
							</div>

							<div class="row mb-3 required">
								<label for="input-manufacturer-image-width" class="col-sm-2 col-form-label">{{ entry_manufacturer_image_size }}</label>
								<div class="col-sm-10">
									<div id="input-image-thumb" class="row">
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_manufacturer_image_width" value="{{ module_ps_live_search_manufacturer_image_width }}" placeholder="{{ entry_width }}" id="input-manufacturer-image-width" class="form-control">
											<div id="error-input-manufacturer-image-width" class="invalid-feedback"></div>
										</div>
										<div class="col-sm-6">
											<input type="text" name="module_ps_live_search_manufacturer_image_height" value="{{ module_ps_live_search_manufacturer_image_height }}" placeholder="{{ entry_height }}" id="input-manufacturer-image-height" class="form-control">
											<div id="error-input-manufacturer-image-height" class="invalid-feedback"></div>
										</div>
									</div>
								</div>
							</div>

						</div>
						<div id="tab-informations" class="tab-pane">

							<div class="row mb-3">
								<label for="input-information-status" class="col-sm-2 col-form-label">{{ entry_information_status }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_ps_live_search_information_status" value="0">
										<input type="checkbox" name="module_ps_live_search_information_status" value="1" class="form-check-input" {% if module_ps_live_search_information_status %} checked{% endif %} id="input-information-status">
									</div>
								</div>
							</div>

						</div>
						<div id="tab-support" class="tab-pane">

							<h3>{{ heading_contact }}</h3>
							{{ text_contact }}

						</div>

					</div>

				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}
